@page "/blazor-bootstrap-datagrid"
@using BlazorBootstrap
@using BlazorCourse.Components.Pages.Databases.BierExample.Model
@using BlazorCourse.Components.Pages.Databases.BierExample.Repository
@using SqlKata.Execution
@using FilterOperator = BlazorBootstrap.FilterOperator
@using Query = SqlKata.Query

<h1>Blazor Boostrap Datagrid</h1>

<Grid TItem="Beer"
      Class="table table-hover table-bordered table-striped"
      DataProvider="CustomersDataProvider"
      AllowSorting="true"
      AllowPaging="true"
      AllowFiltering="true"
>
    <GridColumn TItem="Beer" HeaderText="Name" PropertyName="Name" SortString="Name" SortKeySelector="item => item.Name"
                HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
        @context.Name
    </GridColumn>

    <GridColumn TItem="Beer" HeaderText="Type" PropertyName="Type" SortString="Type" SortKeySelector="item => item.Type"
                HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
        @context.Type
    </GridColumn>
    
    <GridColumn TItem="Beer" HeaderText="Style" PropertyName="Style" SortString="Style" SortKeySelector="item => item.Style"
                HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
        @context.Style
    </GridColumn>
    
    <GridColumn TItem="Beer" HeaderText="Alcohol" PropertyName="Alcohol" SortString="Alcohol" SortKeySelector="item => item.Alcohol"
                HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
        @context.Alcohol
    </GridColumn>
</Grid>

@code {
    private async Task<GridDataProviderResult<Beer>> CustomersDataProvider(GridDataProviderRequest<Beer> request)
    {
        using var queryFactory = BeerRepository.CreateQueryFactory();

        var query =
            queryFactory
                .Query("Beer");

        //niet nodig met Paginate<Beer> methode
        // var beersCount =
        //       beersQuery
        //             .Clone()
        //             .Count<int>();

        SortQuery(request, query);

        FilterQuery(request, query);

        var beers = query
            .Paginate<Beer>(request.PageNumber, request.PageSize);

        return await Task.FromResult(
            new GridDataProviderResult<Beer> { Data = beers.List, TotalCount = Convert.ToInt32(beers.Count) });
    }

    private static void SortQuery(GridDataProviderRequest<Beer> request, Query query)
    {
        if (request.Sorting is not null && request.Sorting.Any())
        {
            // Note: Multi column sorting is not supported at this moment
            string sortString = request.Sorting.FirstOrDefault()!.SortString;
            var sortDirection = request.Sorting.FirstOrDefault()!.SortDirection;

            switch (sortDirection)
            {
                case SortDirection.Ascending: query.OrderBy(sortString); break;
                case SortDirection.Descending: query.OrderByDesc(sortString); break;
            }
        }
    }

    private static void FilterQuery(GridDataProviderRequest<Beer> request, Query query)
    {
        if (request.Filters is not null && request.Filters.Any())
        {
            foreach (var filter in request.Filters)
            {
                var filterColumn = filter.PropertyName;
                var filterOperator = filter.Operator;
                var filterValue = filter.Value;
                
                query = FilterQueryByColumn(filterColumn, query, filterOperator, filterValue);
            }
        }
    }

    private static Query FilterQueryByColumn(string filterColumn, Query query, FilterOperator filterOperator,
        string filterValue)
    {
        {
            var isNumeric = IsNumericColumn<Beer>(filterColumn);

            query = filterOperator switch
            {
                // --- equality ---
                FilterOperator.Equals
                    => query.Where(filterColumn, ParseIfNumeric(filterValue, isNumeric)),
                FilterOperator.NotEquals
                    => query.WhereNot(filterColumn, ParseIfNumeric(filterValue, isNumeric)),

                // --- numeric comparisons ---
                FilterOperator.LessThan
                    => query.Where(filterColumn, "<", ParseIfNumeric(filterValue, isNumeric)),
                FilterOperator.LessThanOrEquals
                    => query.Where(filterColumn, "<=", ParseIfNumeric(filterValue, isNumeric)),
                FilterOperator.GreaterThan
                    => query.Where(filterColumn, ">", ParseIfNumeric(filterValue, isNumeric)),
                FilterOperator.GreaterThanOrEquals
                    => query.Where(filterColumn, ">=", ParseIfNumeric(filterValue, isNumeric)),

                // --- text search ---
                FilterOperator.Contains
                    => query.Where(filterColumn, "like", $"%{filterValue}%"),
                FilterOperator.StartsWith
                    => query.Where(filterColumn, "like", $"{filterValue}%"),
                FilterOperator.EndsWith
                    => query.Where(filterColumn, "like", $"%{filterValue}"),

                // --- null / empty checks (no value needed) ---
                FilterOperator.IsNull => query.WhereNull(filterColumn),
                FilterOperator.IsNotNull => query.WhereNotNull(filterColumn),
                FilterOperator.IsEmpty => query.Where(filterColumn, ""),
                FilterOperator.IsNotEmpty => query.WhereNot(filterColumn, ""),

                // unknown operator — skip
                _ => query
            };
            return query;
        }

        static object ParseIfNumeric(string? value, bool isNumeric) =>
            isNumeric && decimal.TryParse(value, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var d)
                ? d
                : (object)(value ?? "");
    }

    private static bool IsNumericColumn<T>(string propertyName)
    {
        var property = typeof(T).GetProperty(propertyName);
        if (property is null)
            return false;

        var propertyType = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;

        return propertyType.IsPrimitive
               && propertyType != typeof(bool)
               || propertyType == typeof(decimal)
               || propertyType == typeof(double)
               || propertyType == typeof(float)
               || propertyType == typeof(byte)
               || propertyType == typeof(sbyte)
               || propertyType == typeof(short)
               || propertyType == typeof(ushort)
               || propertyType == typeof(int)
               || propertyType == typeof(uint)
               || propertyType == typeof(long)
               || propertyType == typeof(ulong);
    }
}