@page "/todo-without-repository"
@using MySqlConnector
@using SqlKata.Compilers
@using SqlKata.Execution
<h3>Todo Without Repository</h3>

@foreach (var todo in _todos)
{
    <p>@todo.Title</p>
}

@code {
    private List<TodoItem> _todos = null!;
    
    protected override void OnInitialized()
    {
        base.OnInitialized();

        var connectionString = ConfigurationHelper.Configuration.GetConnectionString("todo")!;
        var queryFactory =  new QueryFactory(new MySqlConnection(connectionString), new MySqlCompiler());
        
        var query = queryFactory
            .Query("TodoItem");

        _todos = query.Get<TodoItem>().ToList();
    }
}